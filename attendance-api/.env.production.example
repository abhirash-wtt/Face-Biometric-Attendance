# Production template for the company server. Copy to attendance-api/.env and replace
# every <...> value. Generate secrets with:  openssl rand -hex 32
# The API refuses to start with NODE_ENV=production while placeholder secrets remain.
NODE_ENV=production
PORT=3000

# Nginx terminates TLS (see deploy/nginx/attendance.conf). Keep the built-in HTTPS
# listener off, otherwise browsers are redirected to :3443, which is not exposed.
HTTPS_ENABLED=false

# docker-compose.prod.yml sets TRUST_PROXY so rate limits see the real client IP via Nginx.
# Rate limits are per client IP per minute. If all staff reach the server through one
# office NAT address, raise AUTH_RATE_LIMIT_PER_MIN.
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=20
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SEC=900

# docker-compose.prod.yml reads these to initialise Postgres, so they must match.
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=attendance
DATABASE_PASSWORD=<strong-db-password>
DATABASE_NAME=attendance

JWT_ACCESS_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<a different openssl rand -hex 32>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

REDIS_HOST=redis
REDIS_PORT=6379

# docker-compose.prod.yml also uses these as the MinIO root credentials.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=<minio-user>
MINIO_SECRET_KEY=<strong-minio-password>
MINIO_BUCKET=attendance-evidence
MINIO_USE_SSL=false

# The model is stored with Git LFS; the API will not start in production without it.
RECOGNITION_PROVIDER=internal
ONNX_MODEL_PATH=./models/arcface_mobile.onnx
SIMILARITY_THRESHOLD=0.90
LIVENESS_THRESHOLD=0.6
IDENTIFY_TOP_K=5
MAX_FACE_SAMPLES=10

GEOFENCE_ENABLED=true
GEOFENCE_RADIUS_M=45
GEOFENCE_BUFFER_M=12
GEOFENCE_INDOOR_RADIUS_M=40
RETENTION_DAYS=90
ATTENDANCE_COOLDOWN_SEC=60
DEVICE_BOOTSTRAP_SECRET=<random-secret>

COMPREFACE_URL=http://compreface:8000
COMPREFACE_API_KEY=

# Bootstrap admin created on first start. Do not run `npm run seed` in production.
ADMIN_EMAIL=<admin@walkingtree.tech>
ADMIN_PASSWORD=<strong-admin-password>

# Required in production: registration OTPs must be emailed, not logged.
SMTP_HOST=<smtp.walkingtree.tech>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
MAIL_FROM=noreply@walkingtree.tech
