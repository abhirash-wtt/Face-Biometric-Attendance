NODE_ENV=local
PORT=3000

# Phone browsers only allow camera + GPS on HTTPS (or localhost). Run `npm run cert:dev`
# to create certs/dev-{key,cert}.pem, then set HTTPS_ENABLED=true and open the kiosk at
# https://<lan-ip>:3443. HTTP on PORT keeps serving the API for the native app.
HTTPS_ENABLED=false
HTTPS_PORT=3443
# HTTPS_KEY_PATH=./certs/dev-key.pem
# HTTPS_CERT_PATH=./certs/dev-cert.pem

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=app
DATABASE_NAME=attendance

JWT_ACCESS_SECRET=change-me-access-secret-local
JWT_REFRESH_SECRET=change-me-refresh-secret-local
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

REDIS_HOST=localhost
REDIS_PORT=6379

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=attendance-evidence
MINIO_USE_SSL=false

RECOGNITION_PROVIDER=internal
ONNX_MODEL_PATH=./models/arcface_mobile.onnx
SIMILARITY_THRESHOLD=0.97
LIVENESS_THRESHOLD=0.6
IDENTIFY_TOP_K=5
GEOFENCE_ENABLED=true
GEOFENCE_RADIUS_M=45
GEOFENCE_BUFFER_M=12
GEOFENCE_INDOOR_RADIUS_M=40
RETENTION_DAYS=90
ATTENDANCE_COOLDOWN_SEC=60
DEVICE_BOOTSTRAP_SECRET=bind-device-once

COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=

ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=Admin@123
