# Template for local / dev / stage. Copy to attendance-api/.env and replace every <...>
# value. Never commit the real .env (it is git-ignored). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The API refuses to start while a required secret is empty or still a <...> placeholder.
NODE_ENV=local
PORT=3000

# Phone browsers only allow camera + GPS on HTTPS (or localhost). Run `npm run cert:dev`
# to create certs/dev-{key,cert}.pem, then set HTTPS_ENABLED=true and open the kiosk at
# https://<lan-ip>:3443. HTTP on PORT keeps serving the API for the native app.
HTTPS_ENABLED=false
HTTPS_PORT=3443
# HTTPS_KEY_PATH=./certs/dev-key.pem
# HTTPS_CERT_PATH=./certs/dev-cert.pem

# setup-db.ps1 and docker-compose.yml create the Postgres role with these values.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=<database-password>
DATABASE_NAME=attendance

# Required. Two different random values.
JWT_ACCESS_SECRET=<random-64-hex-chars>
JWT_REFRESH_SECRET=<different-random-64-hex-chars>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO keys are required only when STORAGE_PROVIDER=minio (docker-compose.yml also uses
# them as the MinIO root credentials).
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=<minio-access-key>
MINIO_SECRET_KEY=<minio-secret-key>
MINIO_BUCKET=attendance-evidence
MINIO_USE_SSL=false

RECOGNITION_PROVIDER=internal
ONNX_MODEL_PATH=./models/arcface_mobile.onnx
SIMILARITY_THRESHOLD=0.90
LIVENESS_THRESHOLD=0.6
IDENTIFY_TOP_K=5
MAX_FACE_SAMPLES=10
GEOFENCE_ENABLED=true
GEOFENCE_RADIUS_M=45
GEOFENCE_BUFFER_M=12
GEOFENCE_INDOOR_RADIUS_M=40
RETENTION_DAYS=90
ATTENDANCE_COOLDOWN_SEC=60

# Required. Kiosk operators type this once in Settings to bind a device; it is never
# shipped inside the web or mobile app.
DEVICE_BOOTSTRAP_SECRET=<random-device-bind-secret>

COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=<compreface-api-key-if-used>

# Bootstrap admin, created on first start when ADMIN_PASSWORD is set.
ADMIN_EMAIL=admin@attendance.local
ADMIN_PASSWORD=<strong-admin-password>

# Optional demo logins (local/dev only). Each account is created only when its password
# is set; leave them empty to skip. Do not set these in production.
DEMO_EMPLOYEE_PASSWORD=
DEMO_BU_PASSWORD=
DEMO_HR_PASSWORD=
DEMO_MANAGER_PASSWORD=

# Optional passwords for the named employee logins created by `npm run seed`.
SEED_EMP001_PASSWORD=
SEED_EMP002_PASSWORD=
SEED_EMP007_PASSWORD=

# Self-registration is limited to @walkingtree.tech and requires an email OTP.
# Leave SMTP_HOST empty in local/dev to log the OTP to the API console instead of sending mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
MAIL_FROM=noreply@walkingtree.tech
